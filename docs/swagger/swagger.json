  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },

    "parameters": {
      "ID": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Database record ID",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      }
    },

    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@college.edu"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Admin@123"
          }
        }
      },

      "CreateStudentRequest": {
        "type": "object",
        "required": [
          "student_id",
          "name",
          "email",
          "department",
          "semester"
        ],
        "properties": {
          "student_id": {
            "type": "string",
            "example": "CSE2026001"
          },
          "name": {
            "type": "string",
            "example": "Rahul Sharma"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "rahul.sharma@college.edu"
          },
          "phone": {
            "type": "string",
            "example": "9876543210"
          },
          "department": {
            "type": "string",
            "example": "CSE"
          },
          "semester": {
            "type": "integer",
            "example": 5
          },
          "section": {
            "type": "string",
            "example": "A"
          },
          "year": {
            "type": "integer",
            "example": 3
          }
        }
      },

      "UpdateStudentRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "semester": {
            "type": "integer"
          },
          "section": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "status": {
            "type": "boolean"
          }
        }
      },

      "CreateFacultyRequest": {
        "type": "object",
        "required": [
          "faculty_id",
          "name",
          "email"
        ],
        "properties": {
          "faculty_id": {
            "type": "string",
            "example": "FAC2026001"
          },
          "name": {
            "type": "string",
            "example": "Dr. Amit Sharma"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "amit.sharma@college.edu"
          },
          "phone": {
            "type": "string"
          },
          "department": {
            "type": "string",
            "example": "CSE"
          },
          "designation": {
            "type": "string",
            "example": "Assistant Professor"
          }
        }
      },

      "UpdateFacultyRequest": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "designation": {
            "type": "string"
          }
        }
      },

      "CreateDepartmentRequest": {
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Computer Science and Engineering"
          },
          "code": {
            "type": "string",
            "example": "CSE"
          },
          "description": {
            "type": "string"
          }
        }
      },

      "UpdateDepartmentRequest": {
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },

      "CreateSubjectRequest": {
        "type": "object",
        "required": [
          "name",
          "code",
          "department_id",
          "semester"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Database Management Systems"
          },
          "code": {
            "type": "string",
            "example": "CS501"
          },
          "department_id": {
            "type": "integer",
            "example": 1
          },
          "semester": {
            "type": "integer",
            "example": 5
          },
          "credits": {
            "type": "integer",
            "example": 4
          }
        }
      },

      "UpdateSubjectRequest": {
        "type": "object",
        "required": [
          "name",
          "code",
          "department_id",
          "semester"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "department_id": {
            "type": "integer"
          },
          "semester": {
            "type": "integer"
          },
          "credits": {
            "type": "integer"
          }
        }
      },

      "CreateAttendanceRequest": {
        "type": "object",
        "required": [
          "student_id",
          "subject_id",
          "faculty_id",
          "date",
          "status"
        ],
        "properties": {
          "student_id": {
            "type": "integer",
            "example": 1
          },
          "subject_id": {
            "type": "integer",
            "example": 1
          },
          "faculty_id": {
            "type": "integer",
            "example": 1
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "late"
            ],
            "example": "present"
          }
        }
      },

      "UpdateAttendanceRequest": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "late"
            ]
          }
        }
      }
    }
  }
}