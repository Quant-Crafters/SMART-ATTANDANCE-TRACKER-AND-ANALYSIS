# Application Configuration
APP_NAME=AI_Attendance_Engine
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=attendsmart
DB_SSLMODE=disable

# ML & Threshold Settings
REQUIRED_ATTENDANCE_PCT=75.0
MODEL_DIR=saved_models
LOG_LEVEL=INFO

# Gemini Multimodal API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
